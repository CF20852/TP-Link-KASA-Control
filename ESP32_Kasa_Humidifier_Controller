String buildPage(const String& msg) {
  String page = FPSTR(PAGE_TEMPLATE);
  page.replace("%LOW%",    String(lowThreshold, 1));
  page.replace("%HIGH%",   String(highThreshold, 1));
  page.replace("%PLUGIP%", plugIP);
  page.replace("%MSG%",    msg);
  return page;
}

// Basic validation of a dotted-quad IPv4 string.
bool isValidIP(const String& s) {
  if (s.length() == 0) return true;  // empty = "no plug configured" is allowed
  IPAddress ip;
  return ip.fromString(s);
}

void setupWebServer() {
  server.on("/", HTTP_GET, [](AsyncWebServerRequest* request) {
    request->send(200, "text/html", buildPage(""));
  });

  server.on("/data", HTTP_GET, [](AsyncWebServerRequest* request) {
    String json = "{";
    json += "\"tempValid\":" + String(sensorOK ? "true" : "false") + ",";
    json += "\"temp\":"      + String(sensorOK ? temperatureF : 0.0, 1) + ",";
    json += "\"hum\":"       + String(sensorOK ? humidity : 0.0, 1) + ",";
    json += "\"plugState\":" + String(plugState);
    json += "}";
    request->send(200, "application/json", json);
  });

  server.on("/save", HTTP_POST, [](AsyncWebServerRequest* request) {
    String msg = "";

    float newLow  = request->hasParam("low",  true) ? request->getParam("low",  true)->value().toFloat() : lowThreshold;
    float newHigh = request->hasParam("high", true) ? request->getParam("high", true)->value().toFloat() : highThreshold;
    String newIP  = request->hasParam("plugip", true) ? request->getParam("plugip", true)->value() : plugIP;
    newIP.trim();

    if (newLow < 0 || newLow > 100 || newHigh < 0 || newHigh > 100) {
      msg = "Thresholds must be between 0 and 100 %RH. Settings not saved.";
    } else if (newLow >= newHigh) {
      msg = "The low threshold must be less than the high threshold. Settings not saved.";
    } else if (!isValidIP(newIP)) {
      msg = "Invalid plug IP address. Settings not saved.";
    } else {
      lowThreshold  = newLow;
      highThreshold = newHigh;
      if (newIP != plugIP) {
        plugIP = newIP;
        plugState = -1;             // state unknown for the new plug
        if (plugIP.length() > 0) kasaQueryState();
      }
      saveSettings();
      applyHumidityControl();       // re-evaluate immediately with new settings
      msg = "Settings saved.";
    }

    request->send(200, "text/html", buildPage(msg));
  });

  server.begin();
}

// ---------------------- Wi-Fi connection management ----------------------
// Applies the fixed IP and (re)starts the connection. Used both at boot
// and any time the connection needs to be restarted.
void connectWiFi() {
  DEBUG_PRINTLN("[WiFi] Starting Wi-Fi setup...");

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();  // clear any previous connection attempt/state first

  DEBUG_PRINT("[WiFi] Static IP: ");     DEBUG_PRINTLN(LOCAL_IP);
  DEBUG_PRINT("[WiFi] Gateway: ");       DEBUG_PRINTLN(GATEWAY_IP);
  DEBUG_PRINT("[WiFi] Subnet mask: ");   DEBUG_PRINTLN(SUBNET_MASK);
  DEBUG_PRINT("[WiFi] Primary DNS: ");   DEBUG_PRINTLN(PRIMARY_DNS);
  DEBUG_PRINT("[WiFi] Secondary DNS: "); DEBUG_PRINTLN(SECONDARY_DNS);

  if (!WiFi.config(LOCAL_IP, GATEWAY_IP, SUBNET_MASK, PRIMARY_DNS, SECONDARY_DNS)) {
    Serial.println("Static IP configuration failed");
  } else {
    DEBUG_PRINTLN("[WiFi] Static IP configuration applied");
  }

  DEBUG_PRINT("[WiFi] Calling WiFi.begin() with SSID: ");
  DEBUG_PRINTLN(WIFI_SSID);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  lastWifiCheck = millis();
}

// ---------------------- Setup / Loop ----------------------
void setup() {
  Serial.begin(115200);
  delay(200);

  loadSettings();

  dht.begin();
  DEBUG_PRINT("[DHT22] Sensor initialized on GPIO ");
  DEBUG_PRINTLN(DHTPIN);

  connectWiFi();
  Serial.print("Connecting to WiFi");
  unsigned long connectStart = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - connectStart < 15000UL) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("Connected. Open http://");
    Serial.println(WiFi.localIP());
    DEBUG_PRINT("[WiFi] MAC address: ");
    DEBUG_PRINTLN(WiFi.macAddress());
    DEBUG_PRINT("[WiFi] Signal strength (RSSI): ");
    DEBUG_PRINT(WiFi.RSSI());
    DEBUG_PRINTLN(" dBm");
  } else {
    Serial.println("Not yet connected; will keep retrying in the background.");
  }

  setupWebServer();  // async server starts listening and runs in the background

  DEBUG_PRINT("[Kasa] Configured plug IP: ");
  DEBUG_PRINTLN(plugIP.length() > 0 ? plugIP : "(none set)");

  if (plugIP.length() > 0) {
    DEBUG_PRINTLN("[Kasa] Querying initial smart plug state...");
    kasaQueryState();
  } else {
    DEBUG_PRINTLN("[Kasa] No plug IP configured yet; skipping initial state query.");
  }

  // Force an immediate first sensor read in loop()
  lastSensorRead = millis() - SENSOR_INTERVAL_MS;
}

void loop() {
  // Check the Wi-Fi link periodically (non-blocking) and restart the
  // connection if it has dropped. Note: with ESPAsyncWebServer there is
  // no server.handleClient() to call — requests are handled via
  // callbacks/interrupts in the background.
  if (millis() - lastWifiCheck >= WIFI_CHECK_INTERVAL_MS) {
    lastWifiCheck = millis();
    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("WiFi is down — restarting connection...");
      connectWiFi();
    }
  }

  if (millis() - lastSensorRead >= SENSOR_INTERVAL_MS) {
    lastSensorRead = millis();

    float h = dht.readHumidity();
    float t = dht.readTemperature();

    if (isnan(h) || isnan(t)) {
      sensorOK = false;
      Serial.println("DHT22 read failed");
    } else {
      sensorOK = true;
      humidity = h;
      temperatureC = t;
      temperatureF = temperatureC * 1.8 + 32;
      Serial.printf("T = %.1f C, RH = %.1f %%\n", t, h);
      applyHumidityControl();
    }

    // Refresh the plug's actual state so the web page reflects reality
    // (e.g. if someone toggled it with the physical button or the app).
    if (plugIP.length() > 0) kasaQueryState();
  }
}
