/*
 * ESP32-DevKitC Humidity Controller with TP-Link Kasa HS103 Smart Plug
 * -------------------------------------------------------------------
 * - Reads a DHT22 (AM2302) on GPIO 4 every 20 seconds.
 * - Hosts a web page (via ESPAsyncWebServer) showing temperature,
 *   humidity, and plug status.
 * - Lets the user set low/high humidity thresholds (defaults 30% / 40% RH)
 *   and the IP address of a Kasa smart plug.
 * - Turns the plug ON when RH < low threshold and OFF when RH > high
 *   threshold (hysteresis band in between = no change).
 * - Talks to the smart plug over TCP port 9999 using the Kasa "autokey" XOR
 *   encryption scheme (initial key 171), with a 4-byte big-endian length
 *   header, which is what the smart plug expects on port 9999.
 * - Connects to Wi-Fi with a fixed (static) IP address and automatically
 *   restarts the Wi-Fi connection if it drops.
 * - Debug logging for Wi-Fi setup, DHT22 setup, and smart-plug
 *   communication can be compiled in or out with the DEBUG_ENABLED
 *   #define below (comment it out to remove debug output entirely).
 *
 * Libraries required (install via Arduino IDE Library Manager):
 *   - "DHT sensor library" by Adafruit (and its dependency
 *     "Adafruit Unified Sensor")
 *   - "ESPAsyncWebServer" (ESP32Async/ESPAsyncWebServer — the maintained
 *     fork; search "ESPAsyncWebServer" in Library Manager)
 *   - "AsyncTCP" (ESP32Async/AsyncTCP — dependency of the above, for ESP32)
 * WiFi.h, WiFiClient.h, and Preferences.h ship with the ESP32 Arduino core.
 *
 * Wiring (DHT22):
 *   VCC  -> 3.3V
 *   DATA -> GPIO 4   (with a 10k pull-up resistor from DATA to 3.3V)
 *   GND  -> GND
 */

#include <WiFi.h>
#include <WiFiClient.h>
#include <Preferences.h>
#include <DHT.h>
#include <AsyncTCP.h>
#include <ESPAsyncWebServer.h>

// ---------------------- User configuration ----------------------
const char* WIFI_SSID     = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// Fixed (static) IP configuration for this device.
// Adjust these four addresses to match your network. LOCAL_IP must be
// outside your router's DHCP pool (or reserved for this device) to avoid
// conflicting with another device.
IPAddress LOCAL_IP     (YOUR_ESP32_IP_ADDR);  // the fixed address this ESP32 will use
IPAddress GATEWAY_IP   (YOUR_ROUTER_ADDRESS);    // your router's address
IPAddress SUBNET_MASK  (YOUR_ROUTER_SUBNET_MASK);
IPAddress PRIMARY_DNS  (YOUR_ROUTER_DNS_ADDRESS);    // usually the router; change if you use a different DNS
IPAddress SECONDARY_DNS(8, 8, 8, 8);        // fallback DNS

// Wi-Fi supervision: how often to check the connection and, if needed,
// restart it.
const unsigned long WIFI_CHECK_INTERVAL_MS = 5000UL;

#define DHTPIN   4
#define DHTTYPE  DHT22

const unsigned long SENSOR_INTERVAL_MS = 20000UL;  // read DHT22 every 20 s
const uint16_t      KASA_PORT          = 9999;     // HS103 local API port

// ---------------------- Debug output ----------------------
// Comment out the line below to compile out all debug output (the
// DEBUG_PRINT* calls then expand to nothing and cost no flash/time).
#define DEBUG_ENABLED

#ifdef DEBUG_ENABLED
  #define DEBUG_PRINT(x)     Serial.print(x)
  #define DEBUG_PRINTLN(x)   Serial.println(x)
  #define DEBUG_PRINTF(...)  Serial.printf(__VA_ARGS__)
#else
  #define DEBUG_PRINT(x)
  #define DEBUG_PRINTLN(x)
  #define DEBUG_PRINTF(...)
#endif

// ---------------------- Globals ----------------------
DHT             dht(DHTPIN, DHTTYPE);
AsyncWebServer  server(80);
Preferences     prefs;

float  temperatureC   = NAN;
float  temperatureF   = NAN;
float  humidity       = NAN;
bool   sensorOK       = false;

float  lowThreshold   = 30.0;   // default low threshold, % RH
float  highThreshold  = 40.0;   // default high threshold, % RH
String plugIP         = "";     // Kasa HS103 IP address (user-supplied)

// Plug state tracking: -1 = unknown, 0 = off, 1 = on
int    plugState      = -1;
bool   plugReachable  = false;

unsigned long lastSensorRead = 0;
unsigned long lastWifiCheck  = 0;

// ---------------------- Kasa XOR "autokey" encryption ----------------------
// Encrypt: key starts at 171; each ciphertext byte = plaintext ^ key,
// and the ciphertext byte becomes the key for the next byte.
void kasaEncrypt(const String& plain, uint8_t* out) {
  uint8_t key = 171;
  for (size_t i = 0; i < plain.length(); i++) {
    key = key ^ (uint8_t)plain[i];
    out[i] = key;
  }
}

// Decrypt: key starts at 171; plaintext byte = ciphertext ^ key,
// and the ciphertext byte becomes the key for the next byte.
String kasaDecrypt(const uint8_t* data, size_t len) {
  uint8_t key = 171;
  String result;
  result.reserve(len);
  for (size_t i = 0; i < len; i++) {
    result += (char)(data[i] ^ key);
    key = data[i];
  }
  return result;
}

// Send a JSON command to the plug over TCP 9999 and return the decrypted
// JSON reply ("" on failure). Port-9999 messages are framed with a 4-byte
// big-endian length prefix. This uses the plain (synchronous) WiFiClient,
// which is fine here since it's called from loop()/form handlers, not
// from inside an async request callback.
String kasaSendCommand(const String& jsonCmd) {
  if (plugIP.length() == 0) return "";

  DEBUG_PRINT("[Kasa] Connecting to plug at ");
  DEBUG_PRINT(plugIP);
  DEBUG_PRINT(":");
  DEBUG_PRINTLN(KASA_PORT);

  WiFiClient client;
  if (!client.connect(plugIP.c_str(), KASA_PORT, 2000)) {
    DEBUG_PRINTLN("[Kasa] Connection to plug failed");
    return "";
  }
  DEBUG_PRINTLN("[Kasa] Connected. Sending command...");
  DEBUG_PRINT("[Kasa] Command JSON: ");
  DEBUG_PRINTLN(jsonCmd);

  size_t len = jsonCmd.length();
  uint8_t header[4] = {
    (uint8_t)((len >> 24) & 0xFF),
    (uint8_t)((len >> 16) & 0xFF),
    (uint8_t)((len >> 8)  & 0xFF),
    (uint8_t)( len        & 0xFF)
  };

  uint8_t* payload = (uint8_t*)malloc(len);
  if (!payload) { client.stop(); return ""; }
  kasaEncrypt(jsonCmd, payload);

  client.write(header, 4);
  client.write(payload, len);
  free(payload);

  // Read the 4-byte length header of the reply
  unsigned long start = millis();
  while (client.available() < 4) {
    if (millis() - start > 2000 || !client.connected()) { client.stop(); return ""; }
    delay(10);
  }
  uint8_t rh[4];
  client.readBytes(rh, 4);
  uint32_t respLen = ((uint32_t)rh[0] << 24) | ((uint32_t)rh[1] << 16) |
                     ((uint32_t)rh[2] << 8)  |  (uint32_t)rh[3];
  if (respLen == 0 || respLen > 4096) { client.stop(); return ""; }

  uint8_t* resp = (uint8_t*)malloc(respLen);
  if (!resp) { client.stop(); return ""; }

  size_t got = 0;
  start = millis();
  while (got < respLen) {
    if (millis() - start > 3000 || (!client.connected() && !client.available())) break;
    int avail = client.available();
    if (avail > 0) {
      size_t toRead = (size_t)respLen - got;
      if ((size_t)avail < toRead) toRead = (size_t)avail;
      got += client.readBytes(resp + got, toRead);
    } else {
      delay(10);
    }
  }
  client.stop();

  String decoded = (got == respLen) ? kasaDecrypt(resp, respLen) : "";
  free(resp);

  DEBUG_PRINT("[Kasa] Reply received: ");
  DEBUG_PRINTLN(decoded.length() > 0 ? decoded : "(none / timeout)");

  return decoded;
}

// Set relay: state = 1 (on) or 0 (off). Returns true on success.
bool kasaSetRelay(int state) {
  DEBUG_PRINT("[Kasa] Setting relay state to ");
  DEBUG_PRINTLN(state == 1 ? "ON" : "OFF");

  String cmd = String("{\"system\":{\"set_relay_state\":{\"state\":") + state + "}}}";
  String reply = kasaSendCommand(cmd);
  bool ok = (reply.indexOf("\"err_code\":0") >= 0);
  plugReachable = (reply.length() > 0);
  if (ok) plugState = state;

  DEBUG_PRINTLN(ok ? "[Kasa] Relay command succeeded" : "[Kasa] Relay command failed");
  return ok;
}

// Query the plug and update plugState from its sysinfo.
void kasaQueryState() {
  DEBUG_PRINTLN("[Kasa] Querying plug status (get_sysinfo)...");

  String reply = kasaSendCommand("{\"system\":{\"get_sysinfo\":{}}}");
  plugReachable = (reply.length() > 0);
  if (!plugReachable) {
    DEBUG_PRINTLN("[Kasa] Plug unreachable");
    plugState = -1;
    return;
  }
  int idx = reply.indexOf("\"relay_state\":");
  if (idx >= 0) {
    char c = reply.charAt(idx + 14);
    if (c == '0') plugState = 0;
    else if (c == '1') plugState = 1;
  }
  DEBUG_PRINT("[Kasa] Plug state is now: ");
  DEBUG_PRINTLN(plugState == 1 ? "ON" : (plugState == 0 ? "OFF" : "Unknown"));
}

// ---------------------- Control logic ----------------------
void applyHumidityControl() {
  if (!sensorOK || plugIP.length() == 0) return;

  if (humidity < lowThreshold) {
    if (plugState != 1) kasaSetRelay(1);   // too dry -> plug ON
  } else if (humidity > highThreshold) {
    if (plugState != 0) kasaSetRelay(0);   // humid enough -> plug OFF
  }
  // Between thresholds: leave the plug as-is (hysteresis).
}

// ---------------------- Persistence ----------------------
void loadSettings() {
  prefs.begin("humctl", true);
  lowThreshold  = prefs.getFloat("low", 30.0);
  highThreshold = prefs.getFloat("high", 40.0);
  plugIP        = prefs.getString("plugip", "");
  prefs.end();
}

void saveSettings() {
  prefs.begin("humctl", false);
  prefs.putFloat("low", lowThreshold);
  prefs.putFloat("high", highThreshold);
  prefs.putString("plugip", plugIP);
  prefs.end();
}

// ---------------------- Web interface ----------------------
const char PAGE_TEMPLATE[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Debi's Humidifier Controller</title>
